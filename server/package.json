    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^6.4.24",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.6",
    "nodemon": "^3.1.7",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
